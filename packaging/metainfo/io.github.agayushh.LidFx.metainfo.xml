<?xml version="1.0" encoding="UTF-8"?>
<component type="addon">
  <id>io.github.agayushh.LidFx</id>
  <extends>org.gnome.Shell</extends>
  <name>LidFx</name>
  <summary>Fold the GNOME desktop with the laptop lid</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.agayushh">
    <name>Ayush Goyal</name>
  </developer>
  <url type="homepage">https://github.com/agayushh/lidfx</url>
  <url type="bugtracker">https://github.com/agayushh/lidfx/issues</url>
  <url type="vcs-browser">https://github.com/agayushh/lidfx</url>
  <description>
    <p>
      LidFx is a GNOME Shell extension that warps the live wallpaper and
      windows as you close the lid. It reads a lid-angle sensor, dual
      accelerometers, or the display IMU, and falls back to the lid webcam
      on clamshells that have none.
    </p>
  </description>
  <releases>
    <release version="5" date="2026-09-18">
      <description>
        <p>Packaged release for GNOME Shell 45–48.</p>
      </description>
    </release>
  </releases>
  <icon type="stock">io.github.agayushh.LidFx</icon>
  <categories>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1"/>
</component>
